            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataHora\": \"2027-03-10T10:30:00\",\n  \"pacienteId\": {{pacienteId}},\n  \"dentistaId\": {{dentistaId}},\n  \"servicoId\": {{servicoId}},\n  \"observacao\": \"Consulta de rotina\"\n}",
